# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Language model ────────────────────────────────────────────────────────────
# Default provider is Aitta, CSC's inference service: https://aitta.csc.fi/public
AITTA_API_KEY=

# Using a different OpenAI-compatible endpoint instead? Point the notebook at it
# and use whichever key it expects. A local Ollama or vLLM server needs no key at
# all — pass any non-empty string.
#   OPENAI_API_KEY=
#   OPENAI_BASE_URL=http://localhost:11434/v1

# ── Embeddings ────────────────────────────────────────────────────────────────
# Only needed if you switch to a gated model on the Hugging Face Hub. The default
# (Qwen/Qwen3-Embedding-0.6B) downloads without one.
HF_TOKEN=

# ── Tracing (optional) ────────────────────────────────────────────────────────
# Langfuse records every node and tool call so you can see what the agent actually
# did. Off unless LANGFUSE_ENABLED=true. Self-host or use https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
